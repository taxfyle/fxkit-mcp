{
  "name": "fxkit-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for FxKit C# functional programming library documentation",
  "main": "dist/index.js",
  "bin": {
    "fxkit-mcp": "./bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "fxkit", "csharp", "functional-programming", "documentation", "model-context-protocol", "ai", "claude"],
  "author": "Anthony Orta <anthony.orta@taxfyle.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxfyle/fxkit-mcp.git"
  },
  "homepage": "https://github.com/taxfyle/fxkit-mcp#readme",
  "bugs": {
    "url": "https://github.com/taxfyle/fxkit-mcp/issues"
  },
  "files": [
    "dist/",
    "bin.js",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "cheerio": "^1.1.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
